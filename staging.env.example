# ==============================================================================
# Vraja SaaS — Staging Environment Configuration Template
# Placeholders only. Do NOT commit real secrets or production credentials.
# ==============================================================================

# 1. Environment & Network Binding
ENVIRONMENT=staging
DEBUG=false
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# 2. Domain & CORS Configuration (Strict HTTPS FQDN)
# Specify every exact HTTPS frontend origin permitted for authenticated mutations.
# If products use separate hosts, list both comma-separated, e.g. https://reviews-staging.example.com,https://cards-staging.example.com
CORS_ORIGINS=https://staging.vraja.yourdomain.com

# 3. Security & Session Secret
# Generate with: openssl rand -hex 32
# Must be at least 32 characters long.
OWNER_SESSION_SECRET=replace-with-at-least-32-character-staging-secret-key-entropy
COOKIE_SECURE=true
SESSION_TTL_HOURS=24

# 4. Storage & Tenant Isolation Paths
# Dedicated directories isolated from development and production files.
REVIEW_DB_PATH=/var/vraja/staging/data/reviews.sqlite3
DOCUMENTS_PATH=/var/vraja/staging/documents
BUSINESS_LINKS_PATH=/var/vraja/staging/data/business_links.json

# 5. Backup & Disaster Recovery Directory
BACKUP_BASE_DIR=/var/vraja/staging/backups

# 6. Distributed Auth & Security Shield Infrastructure (SEC-04 / SEC-05 / Phase A6)
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_FAILURE_POLICY=fail_closed
SECURITY_HMAC_SECRET=replace-with-at-least-32-character-hmac-secret-key-entropy
SECURITY_HMAC_SECRET_PREVIOUS=
SECURITY_DB_PATH=/var/vraja/staging/data/security_shield.sqlite3
ALLOWED_HOSTS=staging.vraja.yourdomain.com,127.0.0.1,localhost
TRUSTED_PROXIES=127.0.0.1,10.0.0.0/8

# 7. Cloudflare Turnstile Anti-Bot Challenge (Non-Dummy Staging Keys Required)
TURNSTILE_ENABLED=true
TURNSTILE_SITE_KEY=replace-with-real-cloudflare-turnstile-site-key
TURNSTILE_SECRET_KEY=replace-with-real-cloudflare-turnstile-secret-key
TURNSTILE_ALLOWED_HOSTNAMES=staging.vraja.yourdomain.com
TURNSTILE_VERIFY_URL=https://challenges.cloudflare.com/turnstile/v0/siteverify

# 8. Security Shield Notification Controls (Keep Mock/Paused Until Live SMTP Authorized)
MOCK_EMAIL_TRANSPORT=true
PAUSE_INCIDENT_DISPATCH=true
ALLOW_LIVE_SMTP_TEST=false
ALERT_RECIPIENT_EMAIL=vajra.techworks@gmail.com

# 9. Optional Legacy Password Fallback (Leave empty in multi-tenant mode)
# OWNER_PASSWORD=optional-staging-fallback-password
