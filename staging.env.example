# ==============================================================================
# Vraja SaaS — Staging Environment Configuration Template
# Placeholders only. Do NOT commit real secrets or production credentials.
# ==============================================================================

# 1. Environment & Network Binding
ENVIRONMENT=staging
DEBUG=false
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# 2. Domain & CORS Configuration (Strict HTTPS FQDN)
# Specify every exact HTTPS frontend origin permitted for authenticated mutations.
# If products use separate hosts, list both comma-separated, e.g. https://reviews-staging.example.com,https://cards-staging.example.com
CORS_ORIGINS=https://staging.vraja.yourdomain.com

# 3. Security & Session Secret
# Generate with: openssl rand -hex 32
# Must be at least 32 characters long.
OWNER_SESSION_SECRET=replace-with-at-least-32-character-staging-secret-key-entropy
COOKIE_SECURE=true
SESSION_TTL_HOURS=24

# 4. Storage & Tenant Isolation Paths
# Dedicated directories isolated from development and production files.
REVIEW_DB_PATH=/var/vraja/staging/data/reviews.sqlite3
DOCUMENTS_PATH=/var/vraja/staging/documents
BUSINESS_LINKS_PATH=/var/vraja/staging/data/business_links.json

# 5. Backup & Disaster Recovery Directory
BACKUP_BASE_DIR=/var/vraja/staging/backups

# 6. Optional Legacy Password Fallback (Leave empty in multi-tenant mode)
# OWNER_PASSWORD=optional-staging-fallback-password
