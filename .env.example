ENVIRONMENT=development
OWNER_PASSWORD=replace-with-a-long-random-development-password
OWNER_SESSION_SECRET=replace-with-at-least-32-random-characters
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174
REVIEW_DB_PATH=./data/nasta-ghar/reviews.sqlite3
BUSINESS_LINKS_PATH=./data/nasta-ghar/business_links.json

# Shared Security & Rate Limiting Infrastructure (SEC-04)
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_FAILURE_POLICY=fail_closed
SECURITY_HMAC_SECRET=replace-with-at-least-32-random-characters-for-account-anonymization
SECURITY_HMAC_SECRET_PREVIOUS=

# Cloudflare Turnstile Progressive Bot Challenge (SEC-04)
TURNSTILE_ENABLED=false
TURNSTILE_SITE_KEY=your-cloudflare-turnstile-site-key
TURNSTILE_SECRET_KEY=your-cloudflare-turnstile-secret-key
TURNSTILE_VERIFY_URL=https://challenges.cloudflare.com/turnstile/v0/siteverify
TURNSTILE_ALLOWED_HOSTNAMES=localhost,127.0.0.1

# Optional frontend values (set in the selected frontend environment, not in a JS secret).
# VITE_BACKEND_URL=http://127.0.0.1:8000  # Vite development proxy target
# VITE_API_BASE_URL=                     # Leave empty to use same-origin /api in production
